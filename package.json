{
  "name": "fms-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "lint": "eslint",
    "test": "vitest run",
    "e2e": "playwright test",
    "api:types": "openapi-typescript src/api/openapi-fms.yaml -o src/api/schema.gen.ts",
    "api:check": "npm run api:types && git diff --exit-code -- src/api/schema.gen.ts",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "happy-dom": "21.0.4",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  },
  "overrides": {
    "rollup": "4.63.6",
    "tinybench": "6.2.0",
    "zod": "4.6.6",
    "@redocly/openapi-core": "1.34.22",
    "ws": "8.22.0"
  }
}
